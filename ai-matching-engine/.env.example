# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
#
# Ask Member 2 for the GCP project ID and Cloud SQL instance name.

GCP_PROJECT=carelink-hackathon
GCP_REGION=asia-southeast1
CLOUD_SQL_CONN=carelink-hackathon:asia-southeast1:carelink-db
DB_NAME=carelink
DB_USER=postgres
DB_PASSWORD=ask-member-2-for-this
