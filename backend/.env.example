# CareLink backend environment
# Copy this file to backend/.env.local for your machine. Do not commit real values.

CARELINK_ENVIRONMENT=local
CARELINK_PORT=8000
CARELINK_CORS_ORIGINS=*
CARELINK_IAP_REQUIRED=false
CARELINK_LOCAL_USER_EMAIL=local.member2@carelink.test

# Local SQLite for quick backend API testing. When this is set, it takes
# precedence over Postgres and Cloud SQL settings.
CARELINK_SQLITE_PATH=./data/carelink.sqlite

# Local Docker Postgres from backend/docker-compose.yml.
# Use this for local development only.
# Leave empty when using SQLite.
# CARELINK_DATABASE_URL=postgres://carelink:carelink@127.0.0.1:5432/carelink
CARELINK_DATABASE_URL=

# Cloud SQL IAM auth mode.
# Leave CARELINK_DATABASE_URL empty when using these settings.
# CARELINK_DATABASE_URL=
# CARELINK_CLOUD_SQL_INSTANCE=YOUR_PROJECT_ID:asia-southeast1:YOUR_INSTANCE_NAME
# CARELINK_DB_NAME=carelink
# CARELINK_DB_USER=YOUR_IAM_DATABASE_USER
# CARELINK_CLOUD_SQL_IP_TYPE=PUBLIC

# Optional local impersonation for service-account IAM DB auth.
# For PostgreSQL service accounts, CARELINK_DB_USER omits ".gserviceaccount.com".
# Example:
# CARELINK_DB_USER=carelink-runtime@hackathon-myhack.iam
# CARELINK_IMPERSONATE_SERVICE_ACCOUNT=carelink-runtime@hackathon-myhack.iam.gserviceaccount.com
