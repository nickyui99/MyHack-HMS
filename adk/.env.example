# CareLink ADK — environment variables
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Authentication is via Application Default Credentials only — no API keys.
# Run once on your machine: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=my-int-agentspaceent-0425
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Model overrides. agent.py defaults to gemini-pro-latest for specialists, which
# is NOT a valid Vertex publisher model — set these to a real model before serving.
# Verified working: gemini-flash-latest (fast, cheap, 5/5 smoke tests pass on it).
CARELINK_ORCHESTRATOR_MODEL=gemini-flash-latest
CARELINK_SPECIALIST_MODEL=gemini-flash-latest
