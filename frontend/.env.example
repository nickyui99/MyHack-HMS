# Copy to .env.local to enable backend integration.
# Leave VITE_API_BASE_URL empty to keep the app in demo (mock) mode.

VITE_API_BASE_URL=http://localhost:8000
# VITE_DEMO_MODE=1   # uncomment to force mock data even with a live API

# ADK chatbot server (Python adk api_server, default port 8100).
# Dev: leave VITE_ADK_BASE_URL unset — Vite proxies /adk → http://localhost:8100
# (vite.config.ts). Override only for prod or to bypass the proxy.
# Empty string disables the chat panel entirely.
# VITE_ADK_BASE_URL=http://localhost:8100
VITE_ADK_PERSONA_USER_ID=gp.amirul@carelink.demo
VITE_ADK_APP_NAME=carelink
